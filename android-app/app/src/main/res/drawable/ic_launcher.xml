<?xml version="1.0" encoding="utf-8"?>
<!--
    DeepDrop app icon — RedMagic Game Space aesthetic.
    Concept: two overlapping "F" + "G" letterforms rendered as angular
    frame-doubling arrows, forming a stylised ">>" chevron motif on a deep-
    black rounded-square background with a red glow gradient.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Background: deep-black rounded square with dark-red radial tint -->
    <path
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z"
        android:fillColor="#08080F" />

    <!-- Subtle radial glow in the centre -->
    <path
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="54"
                android:type="radial">
                <item android:offset="0" android:color="#33FF1744" />
                <item android:offset="0.6" android:color="#08FF1744" />
                <item android:offset="1" android:color="#00FF1744" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Left chevron arrow (frame N) -->
    <path
        android:pathData="
            M24,32 L44,54 L24,76
            L32,76 L52,54 L32,32 Z"
        android:fillColor="#FF1744"
        android:fillAlpha="0.85" />

    <!-- Right chevron arrow (frame N+1 — offset to suggest doubling) -->
    <path
        android:pathData="
            M38,32 L58,54 L38,76
            L46,76 L66,54 L46,32 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="38"
                android:startY="32"
                android:endX="66"
                android:endY="76"
                android:type="linear">
                <item android:offset="0" android:color="#FF4069" />
                <item android:offset="1" android:color="#FF1744" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Third faded trail arrow — implies ×3/×4 frame multiplication -->
    <path
        android:pathData="
            M52,32 L72,54 L52,76
            L60,76 L80,54 L60,32 Z"
        android:fillColor="#FF1744"
        android:fillAlpha="0.30" />

    <!-- Bottom label: "FG" in tight monospace style -->
    <path
        android:pathData="
            M31,84 L31,90 L39,90 L39,88 L33,88 L33,87 L38,87 L38,85 L33,85
            L33,84 Z
            M42,84 L42,90 L50,90 L50,88 L44,88 L44,84 Z"
        android:fillColor="#FF1744"
        android:fillAlpha="0.70" />

    <!-- Horizontal separator line above label -->
    <path
        android:pathData="M22,81 L86,81"
        android:strokeWidth="0.8"
        android:strokeColor="#FF1744"
        android:strokeAlpha="0.40"
        android:fillColor="@android:color/transparent" />

</vector>
