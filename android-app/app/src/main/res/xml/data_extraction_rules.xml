<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude cache dirs and native crash / log files from cloud backup. -->
        <exclude domain="file" path="spirv/" />
        <exclude domain="file" path="native_crash.txt" />
        <exclude domain="file" path="native_log.txt" />
        <exclude domain="external-files" path="benchmarks/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="spirv/" />
    </device-transfer>
</data-extraction-rules>
